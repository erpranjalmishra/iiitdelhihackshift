# Copy to .env (git-ignored) — or paste the key in the app under Settings → AI engine.

# Google Gemini API key (free at https://aistudio.google.com/apikey).
# Without it, Nadi runs on its built-in offline clinical engine.
GEMINI_API_KEY=

# Optional: pin a model. By default Nadi lists the models your key can use and
# picks the best available of gemini-3.8-flash → 3.6-flash → 3.5-flash → gemini-flash-latest → …
# and, on a free-tier 429, rests that model for 60 s while the next one answers.
# GEMINI_MODEL=gemini-flash-latest

# Optional: reasoning depth for symptom triage (low | medium | high). Default low:
# ~10 s per check on 3.8-flash vs ~20 s at medium, with the same quality in testing.
# GEMINI_THINKING=low

# Optional: force the offline engine even when a key is set (e.g. for a no-internet demo).
# NADI_AI=offline

# Ports. HTTPS starts automatically once certs exist (npm run certs) — phones need it for the camera.
# PORT=3000
# HTTPS_PORT=3443

# Optional: database location (default data/nadi.db).
# NADI_DB=
